; INFO v1.0.0 — Pure QF_LIA Balke-Pearl Simplex Soundness & Range-Coder Split Invariant
(set-logic QF_LIA)

(declare-const p00 Int) (declare-const p01 Int) (declare-const p10 Int) (declare-const p11 Int)
(declare-const D Int)

; CHECK 1: Anti-vacuity for probability simplex (expect SAT)
(push)
(assert (and (>= p00 0) (>= p01 0) (>= p10 0) (>= p11 0)))
(assert (= D (+ p00 p01 p10 p11)))
(assert (> D 0))
(assert (> (+ p00 p11) 0))
(check-sat)
(pop)

; CHECK 2: Balke-Pearl probability simplex soundness — upper <= D and lower >= -D (expect UNSAT)
(push)
(assert (and (>= p00 0) (>= p01 0) (>= p10 0) (>= p11 0)))
(assert (= D (+ p00 p01 p10 p11)))
(assert (> D 0))
(assert (or (> (+ p00 p11) D) (< (- (+ p01 p10)) (- D))))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — signed pseudo-probabilities break simplex bound > D (expect SAT)
(push)
(assert (= D (+ p00 p01 p10 p11)))
(assert (> D 0))
(assert (< p01 0))
(assert (> (+ p00 p11) D))
(check-sat)
(pop)

; CHECK 4: 32-bit binary arithmetic coder split strictly inside (low, high) (expect UNSAT)
(declare-const low Int) (declare-const high Int) (declare-const q Int) (declare-const split Int)
(push)
(assert (>= low 0))
(assert (>= (- high low) 4096))
(assert (= split (+ low q)))
(assert (or
  (and (<= (* 4096 q) (* 1 (- high low))) (< (* 1 (- high low)) (* 4096 (+ q 1))))
  (and (<= (* 4096 q) (* 2048 (- high low))) (< (* 2048 (- high low)) (* 4096 (+ q 1))))
  (and (<= (* 4096 q) (* 4095 (- high low))) (< (* 4095 (- high low)) (* 4096 (+ q 1))))))
(assert (or (<= split low) (>= split high)))
(check-sat)
(pop)
